# Copy to .env in the StudyAI folder. Do NOT commit .env or share your key.
# The Flask server reads the key; never paste it into browser JavaScript or index.html.
OPENAI_API_KEY=
# Optional model names:
STUDYAI_TEXT_MODEL=gpt-4o-mini
STUDYAI_SPEECH_MODEL=tts-1
# Set your own random secret for sessions; essential before any public deployment.
SECRET_KEY=
# For a HTTPS deployment, set COOKIE_SECURE=1
COOKIE_SECURE=0
