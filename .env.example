# Copy this file to .env in the StudyAI folder.
# NEVER commit .env or share your API key.
# The Flask server reads the Gemini key; it is never placed in browser JavaScript.

GEMINI_API_KEY=

# Optional Gemini model overrides.
# These defaults currently support StudyAI Personal AI text + two-speaker TTS.
STUDYAI_GEMINI_TEXT_MODEL=gemini-3.6-flash
STUDYAI_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
STUDYAI_GEMINI_TTS_LANGUAGE=en-IN

# Set your own long random secret before public deployment.
SECRET_KEY=

# For a real HTTPS deployment, set COOKIE_SECURE=1.
COOKIE_SECURE=0


# Optional private-beta gate. Leave blank for open registration.\n# When set, new accounts must enter this invite code.\nBETA_ACCESS_CODE=\n\n# Public-beta Personal AI abuse protection.
# 0 disables the daily cap; keep finite values on public deployments.
STUDYAI_AI_DAILY_TEXT_LIMIT=60
STUDYAI_AI_DAILY_AUDIO_LIMIT=10

# Local server defaults.
PORT=5000
FLASK_DEBUG=1
DATABASE_PATH=studyai.db

# Production HTTPS checklist:
# COOKIE_SECURE=1
# FLASK_DEBUG=0
# SECRET_KEY=<long random secret>
# DATABASE_PATH must point to persistent storage if you still use SQLite.

# Set to 1 only when deployed behind a trusted reverse proxy that supplies X-Forwarded-* headers.
TRUST_PROXY=0
