# Copy this file to .env in the StudyAI folder.
# NEVER commit .env or share your API key.
# The Flask server reads the Gemini key; it is never placed in browser JavaScript.

GEMINI_API_KEY=

# Optional Gemini model overrides.
# These defaults currently support StudyAI Personal AI text + two-speaker TTS.
STUDYAI_GEMINI_TEXT_MODEL=gemini-2.5-flash
STUDYAI_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
STUDYAI_GEMINI_TTS_LANGUAGE=en-IN

# Set your own long random secret before public deployment.
SECRET_KEY=

# For a real HTTPS deployment, set COOKIE_SECURE=1.
COOKIE_SECURE=0
